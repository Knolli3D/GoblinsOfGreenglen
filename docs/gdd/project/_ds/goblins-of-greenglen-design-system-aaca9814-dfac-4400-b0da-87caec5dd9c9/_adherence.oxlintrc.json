{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/core/**",
              "components/hud/**",
              "components/navigation/**",
              "ui_kits/main-menu/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel))/i]",
        "message": "Font not provided by the design system. Available: Cinzel."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreenglenButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|height|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<GreenglenButton> doesn't accept that prop. Declared props: label, height, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreenglenHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|size|align|accent|key|ref|className|style|children)$/]",
        "message": "<GreenglenHeading> doesn't accept that prop. Declared props: text, size, align, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreenglenHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<GreenglenHeading> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartsMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:health|maxHealth|size|key|ref|className|style|children)$/]",
        "message": "<HeartsMeter> doesn't accept that prop. Declared props: health, maxHealth, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|value|color|key|ref|className|style|children)$/]",
        "message": "<StatValue> doesn't accept that prop. Declared props: caption, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubmenuShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|background|dim|children|key|ref|className|style|children)$/]",
        "message": "<SubmenuShell> doesn't accept that prop. Declared props: title, background, dim, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubmenuShell'] > JSXAttribute[name.name='background'] > Literal[value!=/^(?:quests|cases|skins|map)$/]",
        "message": "<SubmenuShell> background must be one of 'quests' | 'cases' | 'skins' | 'map'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|label|key|ref|className|style|children)$/]",
        "message": "<TierBadge> doesn't accept that prop. Declared props: tier, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierBadge'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:rare|epic|legendary|starter|default)$/]",
        "message": "<TierBadge> tier must be one of 'rare' | 'epic' | 'legendary' | 'starter' | 'default'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "GreenglenButton": {
        "replaces": []
